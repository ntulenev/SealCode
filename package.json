{
  "name": "sealcode-client-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:client && npm run test:e2e",
    "test:client": "c8 --all --include=src/SealCode/wwwroot/*.js --exclude=src/SealCode/wwwroot/client-types.js --exclude=src/SealCode/wwwroot/*-main.js --exclude=src/SealCode/wwwroot/room.js --exclude=src/SealCode/wwwroot/version.js --check-coverage --lines=68 --branches=86 --functions=87 --reporter=text --reporter=lcov --reports-dir=coverage/client node --test tests/client/*.test.js",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "devDependencies": {
    "@microsoft/signalr": "10.0.11",
    "@playwright/test": "1.62.0",
    "c8": "10.1.3",
    "esbuild": "0.28.2",
    "monaco-editor": "0.47.0",
    "typescript": "5.9.3",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.29"
  }
}
