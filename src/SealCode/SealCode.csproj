<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>
	<PropertyGroup>
		<NuGetAuditMode>all</NuGetAuditMode>
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>CA1873</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Abstractions\**\*.cs" />
		<Compile Remove="Models\**\*.cs" />
		<Compile Remove="Logic\**\*.cs" />
		<Compile Remove="Transport\**\*.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
		<ProjectReference Include="..\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\Logic\Logic.csproj" />
		<ProjectReference Include="..\Models\Models.csproj" />
		<ProjectReference Include="..\Transport\Transport.csproj" />
	</ItemGroup>
  <Target Name="BuildClientAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipClientBuild)' != 'true'">
    <Exec Command="npm run build:client" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
    <ItemGroup>
      <Content Include="wwwroot/assets/**/*" Exclude="@(Content)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
