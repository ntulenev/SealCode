{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "SealCode question library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "groups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "title",
          "questions"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "general, whiteboard or a configured Monaco language identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "topic",
                "description"
              ],
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "topic": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A short summary of the skills and concepts covered by the question."
                },
                "file": {
                  "type": "string",
                  "pattern": "^[^/\\\\:]+\\.md$"
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "description": "Version 2: consecutive examples beginning at one. Use instead of file.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "number",
                      "title",
                      "file"
                    ],
                    "properties": {
                      "number": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file": {
                        "type": "string",
                        "pattern": "^[^/\\\\:]+\\.md$"
                      }
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "file"
                  ],
                  "not": {
                    "required": [
                      "steps"
                    ]
                  }
                },
                {
                  "required": [
                    "steps"
                  ],
                  "not": {
                    "required": [
                      "file"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "items": {
              "properties": {
                "questions": {
                  "items": {
                    "not": {
                      "required": [
                        "steps"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
